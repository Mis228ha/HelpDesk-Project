# Скопируйте этот файл в .env и заполните реальными значениями.
# Сам .env не должен попадать в git (см. .gitignore).

# Django
DJANGO_SECRET_KEY=django-insecure-change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# База данных для продакшена (prod.py).
# Пока PostgreSQL не подключен — переменную можно не указывать,
# будет использован SQLite. Когда будете готовы перейти на PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/helpdesk_db

# Почта для продакшена (prod.py)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
