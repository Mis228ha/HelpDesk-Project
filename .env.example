# Скопируйте этот файл в .env и заполните реальными значениями.
# Сам .env не должен попадать в git (см. .gitignore).

# Django
DJANGO_SECRET_KEY=django-insecure-change-me-to-a-random-value
DJANGO_DEBUG=True
# Используется в prod.py. В dev.py ALLOWED_HOSTS = ["*"] (доступ по LAN), эта переменная там не нужна.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Необязательно (dev.py): адреса со схемой и портом, если при доступе по IP формы
# падают с ошибкой CSRF. Пример: http://192.168.1.50:8000
# DJANGO_CSRF_TRUSTED_ORIGINS=

# База данных для продакшена (prod.py).
# Пока PostgreSQL не подключен — переменную можно не указывать,
# будет использован SQLite. Когда будете готовы перейти на PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/helpdesk_db
DB_NAME=helpdesk_db
DB_USER=helpdesk_user
DB_PASSWORD=change_me_to_a_strong_password
DB_HOST=localhost
DB_PORT=5432

# True — SQLite (db.sqlite3), переменные DB_* при этом не читаются
USE_SQLITE=False

# Почта для продакшена (prod.py)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=